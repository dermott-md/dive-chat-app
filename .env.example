# ============================================================================
#  Dive Starter Kit — configuration
#  Copy this file to `.env.local` and fill in the four values below.
# ============================================================================

# 1) Your Anthropic (Claude) API key — powers the chat + the report builder.
#    Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# 2) A MotherDuck SERVICE ACCOUNT read/write token.
#    Used server-side for (a) minting Dive embed sessions and (b) running the
#    AI chat's SQL queries through the MotherDuck MCP server.
#    Requires a MotherDuck Business plan. Create one under:
#    Settings → Service accounts (give it the "Admin" preset role, which
#    includes permission to create Dive embed sessions).
MOTHERDUCK_TOKEN=

# 3) The USERNAME of that same service account (the embed-session API needs it).
MD_SERVICE_ACCOUNT_USERNAME=

# 4) The Dive ID shown full-screen on the home ("Explore") page.
#    Find it in the Dive's URL, or via the MCP list_dives tool.
#    IMPORTANT: this Dive's data must be shared with the service account above.
#    (Leave blank and the Explore page will show a setup card until you set it.)
NEXT_PUBLIC_EXPLORE_DIVE_ID=

# ---------------------------------------------------------------------------
# Optional overrides (sensible defaults are used if you leave these blank)
# ---------------------------------------------------------------------------
# Model for the chat panels (default: claude-sonnet-4-6)
# CHAT_MODEL=claude-sonnet-4-6
# Model for the report builder — stronger model recommended (default: claude-opus-4-8)
# BUILD_MODEL=claude-opus-4-8
# App name shown in the top nav (default: "Pack Power")
NEXT_PUBLIC_APP_NAME=Pack Power
#
# Advanced: attach specific shares/databases to every embed session. Needed when
# your dive's data lives behind a share that the service account must read, or
# when a dive references a database by a name you want to map from a share.
# JSON array of {url, alias}. Example:
# EMBED_REQUIRED_RESOURCES=[{"url":"md:_share/my_db_share/<uuid>","alias":"my_db"}]
